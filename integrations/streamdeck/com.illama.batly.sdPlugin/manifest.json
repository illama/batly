{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Batly",
  "Version": "1.0.0.0",
  "Author": "Batly",
  "Description": "Battery level of your Logitech (and other) devices, from Batly.",
  "URL": "https://github.com/illama/batly",
  "Category": "Batly",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "CodePath": "plugin/index.html",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.0" },
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Actions": [
    {
      "UUID": "com.illama.batly.battery",
      "Name": "Battery level",
      "Tooltip": "Shows the battery level of a device. Press to refresh, hold to open the Batly page.",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "pi/index.html",
      "SupportedInMultiActions": false,
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    }
  ]
}
